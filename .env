PORT=3000
NODE_ENV=development

# Get a key from https://opencricketapi.com/
OPENCRICKET_API_KEY=oc_live_VhEiodYtHPhfGV8IPk5az9qB9BiEfoJu
OPENCRICKET_BASE_URL=https://opencricketapi.com

# Free Starter has 5,000 requests/month. Keep this high to protect the quota.
# 900 seconds = 15 minutes; one live endpoint refresh can use ~2,880 requests/month.
CACHE_LIVE_SECONDS=900
CACHE_MATCHES_SECONDS=900
CACHE_REFERENCE_SECONDS=21600
CACHE_SCORECARD_SECONDS=3600
CACHE_DELIVERIES_SECONDS=86400

# Optional: comma-separated allowed frontend origins, e.g. http://127.0.0.1:5500
# Leave blank during local development. Set this before public deployment.
CORS_ORIGINS=
